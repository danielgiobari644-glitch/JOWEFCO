rules_version = '2';

// ====================================================================
// JOWEFCO — Firestore Security Rules
// ====================================================================
//
// ⚠️  ACTION REQUIRED: DEPLOY THESE RULES
//
//   If you see "Missing or insufficient permissions" errors in the
//   browser console, it means these rules have NOT been published yet.
//
//   To deploy (one-time setup):
//
//     1. Install Firebase CLI:   npm install -g firebase-tools
//     2. Log in:                 firebase login
//     3. Initialise (if needed): firebase init firestore
//        — select "jowefco" project when prompted
//     4. Deploy:                 firebase deploy --only firestore:rules
//
//   After step 4 the public pages will load data correctly.
//   You only need to do this once (or after editing this file).
//
// ====================================================================
// App behavior:
//   • Public visitors are ANONYMOUS (no Firebase Auth).
//     They get a custom `user_...` id stored in localStorage.
//   • Only the ADMIN signs in via Firebase Authentication.
//   • Therefore: creates from the public must be allowed without auth,
//     but reads of private data (orders, bookings, chats) are restricted
//     by the `userId` field that the client passes in.
//   • The admin is identified by their Firebase Auth UID.
//
// Collections:
//   users/{userId}                          — visitor registration
//   portfolio/{itemId}                      — showcase projects
//   testimonials/{id}                       — reviews
//   projectBookings/{id}                    — project inquiries
//   projectChats/{chatId}                   — chat thread metadata
//   projectChats/{chatId}/messages/{msgId}  — messages inside a chat
//   shopItems/{productId}                   — shop catalog
//   shopOrders/{orderId}                    — orders
//   pageBlocks/{blockId}                    — admin-managed content blocks (text, cards, images)
//   settings/{hero, contact, social, payment, whatsapp, business, branding, sms} — site config
//
// HOW TO ACTIVATE ADMIN ACCESS:
//   1. Create your admin account in Firebase Console → Authentication → Users
//      Authorized JOWEFCO admin email addresses (for password-reset):
//        • danielgiobari644@gmail.com
//        • jowefcotech@gmail.com
//      (These are the only accounts that should be granted admin privileges.
//       They are NOT exposed in the public website UI.)
//   2. Copy that user's UID (click the user → copy "User UID")
//   3. Replace 'REPLACE_WITH_ADMIN_UID' below with that UID
//   4. Publish the rules
// ====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // ADMIN DETECTION
    // ----------------------------------------------------------------
    // ⚠️  YOU MUST REPLACE THE UID BELOW WITH YOUR ACTUAL FIREBASE AUTH UID!
    //
    //   1. Go to Firebase Console → Authentication → Users
    //   2. Click your admin user → copy the "User UID"
    //   3. Paste it between the quotes below (replace REPLACE_WITH_ADMIN_UID)
    //   4. Re-deploy:  firebase deploy --only firestore:rules
    //
    //   If you skip this, the admin panel CANNOT read orders, bookings,
    //   or pending reviews.  The public site works fine regardless.
    // ----------------------------------------------------------------
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }

    // ----------------------------------------------------------------
    // USERS — anyone can register and update their own visitor record
    // (User data is just name + phone entered by the visitor themselves,
    // so there's no sensitive info to protect here. Admin-only reads
    // would break the public registration flow.)
    // ----------------------------------------------------------------
    match /users/{userId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'name', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && request.resource.data.id == userId;
      // Public visitors can update their own record (e.g. lastVisit)
      // Admin can read/update/delete any user
      allow read, update: if true;
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // PORTFOLIO — public read, admin write
    // ----------------------------------------------------------------
    match /portfolio/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // TESTIMONIALS — public reads approved; anyone submits pending
    // ----------------------------------------------------------------
    match /testimonials/{testimonialId} {
      // Public can read only APPROVED testimonials;
      // Admin can read ALL testimonials (including pending ones).
      allow read: if resource.data.approved == true || isAdmin();

      // Anyone can submit a pending review (must be approved = false)
      allow create: if request.resource.data.keys().hasAll(['name', 'rating', 'text', 'approved'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.approved == false;

      // Only admin can approve, edit, or delete reviews
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // PROJECT BOOKINGS — anyone can create; admin reads/updates all
    // ----------------------------------------------------------------
    // NOTE: Public visitors are anonymous, so we cannot enforce ownership
    // via auth.uid. The client sends `userId` (a localStorage id) which
    // is used by the admin panel to identify the customer. Anyone can
    // create a booking; reads are admin-only (the client queries by
    // userId locally, but Firestore rules can't verify localStorage ids).
    // ----------------------------------------------------------------
    match /projectBookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll(['userId', 'customerName', 'customerPhone', 'title', 'description', 'status'])
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0
                    && request.resource.data.customerPhone is string
                    && request.resource.data.customerPhone.size() > 0
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0;

      // Reads + updates + deletes are admin-only.
      // (If you want users to read their own bookings by userId, you must
      // enable Firebase Anonymous Auth and relax this rule. For now, the
      // client just won't see them in the public UI; the admin sees all.)
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // PROJECT CHATS — chat thread metadata
    // ----------------------------------------------------------------
    match /projectChats/{chatId} {
      // Anyone can create a chat thread when submitting a project inquiry
      allow create: if request.resource.data.keys().hasAll(['userId', 'userName', 'projectId'])
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() > 0
                    && request.resource.data.projectId is string
                    && request.resource.data.projectId.size() > 0;

      // Admin can read/update all chats.
      // Public visitors cannot list chats (they would need to know the chatId
      // to read — but the client stores the chatId in localStorage and uses
      // onSnapshot on a specific doc, so we allow get on individual docs).
      allow get: if true;             // allow fetching a single chat by id
      allow list: if isAdmin();        // only admin can list all chats
      allow update: if isAdmin()
                    || request.resource.data.keys().hasAny(['unreadUser', 'lastMessage', 'lastMessageTime']);
      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // MESSAGES inside a project chat
      // ------------------------------------------------------------
      match /messages/{messageId} {
        // Anyone can read messages in a chat if they know the chatId
        // (the chatId acts as a capability token in this design)
        allow read: if true;

        // Anyone can add a message — must include sender + message + timestamp
        allow create: if request.resource.data.keys().hasAll(['sender', 'message', 'timestamp'])
                      && request.resource.data.sender is string
                      && (request.resource.data.sender == 'user'
                          || request.resource.data.sender == 'admin')
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 5000;

        // Messages are immutable; only admin can delete
        allow update, delete: if isAdmin();
      }
    }

    // ----------------------------------------------------------------
    // SHOP ITEMS — public read catalog; admin writes
    // ----------------------------------------------------------------
    match /shopItems/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // SHOP ORDERS — WhatsApp-based ordering flow
    // ----------------------------------------------------------------
    // Public visitors create an order record when they click "Order on
    // WhatsApp" from a product page. The order is created with
    //   orderStatus   = 'awaiting_discussion'
    //   paymentStatus = 'pending'
    // and the WhatsApp deep-link opens in their browser.
    //
    // Only admin can read, update status, fill in delivery details, or
    // confirm payment. The customer can fetch a single order by ID for
    // tracking (uses the order doc ID as a capability token).
    //
    // Required fields at create time:
    //   userId, customerName, customerPhone, orderReference, productId,
    //   productName, quantity, listedPrice, orderStatus, paymentStatus,
    //   paymentMethod, deliveryLocation, createdAt
    //
    // Optional fields at create time:
    //   customerWhatsapp, customerNotes, productImageUrl, storeUrl, storeUrl
    // ----------------------------------------------------------------
    match /shopOrders/{orderId} {
      // PUBLIC can CREATE an order-request (anonymous checkout via WhatsApp)
      allow create: if request.resource.data.keys().hasAll([
          'userId', 'customerName', 'customerPhone', 'orderReference',
          'productId', 'productName', 'quantity', 'listedPrice',
          'orderStatus', 'paymentStatus', 'paymentMethod',
          'deliveryLocation', 'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() > 0
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.listedPrice is number
        && request.resource.data.listedPrice >= 0
        && request.resource.data.orderStatus == 'awaiting_discussion'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentMethod == 'manual';

      // PUBLIC can fetch a SINGLE order by ID (for tracking) — the order doc
      // ID is a capability token; only someone who knows it can read it.
      // This lets customers track their own order using the orderReference
      // → docId mapping that the customer page derives from a public lookup.
      // (Admin can list all orders via isAdmin() below.)
      allow get: if true;

      // ADMIN can read/update/delete ANY order — including:
      //   • confirm payment  (paymentStatus → 'confirmed')
      //   • update status    (orderStatus → 'order_agreed', 'payment_pending',
      //                       'payment_confirmed', 'delivery_scheduled',
      //                       'out_for_delivery', 'delivered', 'cancelled')
      //   • fill delivery    (deliveryAddress, deliveryDate, deliveryTime,
      //                       deliveryInstructions)
      //   • set agreedPrice
      allow list, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // PAGE BLOCKS — admin-managed content blocks (text, cards, images)
    // Public visitors read blocks for the current page; admin writes them.
    // Each block has: pageId (e.g. 'index', 'about'), zone ('top'|'bottom'),
    // position (sort order), type, content.
    // ----------------------------------------------------------------
    match /pageBlocks/{blockId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // SETTINGS — public read, admin write only
    // (hero, contact, social, payment, whatsapp, business, branding, sms)
    //
    // ⚠️  NEVER store secret keys here. Only public keys and IDs.
    //     - Bank account details (public by design — printed on invoices)
    //     - WhatsApp number (public)
    //     - Workshop address + lat/lng (public — used for directions)
    //     - Currency code/symbol
    //     - Hero text + media URLs
    //     - Contact phone/email/address
    //     - Social media URLs
    //     - Branding (logo URL, tagline)
    //     - Termii Sender ID (the API key is stored here too, but it's
    //       only read by admin — if you want stricter security, split
    //       SMS settings into a separate doc restricted to admin reads)
    // ----------------------------------------------------------------
    match /settings/{docId} {
      // Public can read all settings EXCEPT the SMS doc (which contains
      // the Termii API key). The SMS doc is admin-only.
      allow read: if docId != 'sms';
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------
    // DEFAULT — deny everything else
    // ----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
